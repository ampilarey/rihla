/.phpunit.cache
/node_modules
/public/hot
# public/build is committed for cPanel/shared hosting deploys without Node.
# Filament's published assets are committed for the same reason: the deploy
# is a `git pull`, and `filament:assets` cannot run where there is no build
# step. `filament:upgrade` republishes them after every composer update, and
# a CI job fails if what is committed has drifted from what the packages ship.
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
