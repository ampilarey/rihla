APP_NAME="Rihla Travels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily, not single: see config/logging.php. On the live host `single` grows
# one file until the account hits its disk quota.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# debug is right for local work. Production wants `warning` or above —
# `rihla:preflight --production` warns when it is left at debug.
LOG_LEVEL=debug

# Local development defaults to SQLite; production runs MySQL/MariaDB on cPanel.
# Create the file first: touch database/database.sqlite
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rihla
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rihla.mv"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Security headers ────────────────────────────────────────────────────────
# HSTS lifetime in seconds, sent only over HTTPS. Browsers cache it, so this
# is not fully reversible: 0 stops the header being issued, but a browser that
# already saw it keeps refusing plain HTTP until the original value expires.
SECURITY_HSTS_MAX_AGE=31536000

# ── TEST auto-deploy ────────────────────────────────────────────────────────
# Shared secret for POST /api/deploy/test-pull, used by the Deploy TEST
# workflow. Leave empty to disable the endpoint entirely (it returns 404).
# Set only on test.rihla.mv; production must never honour this.
# See docs/TEST_AUTO_DEPLOY.md.
TEST_DEPLOY_WEBHOOK_SECRET=
TEST_DEPLOY_ALLOWED_HOSTS=test.rihla.mv
